# =========================================================
# ARQUIVO .env.example - Modelo de configuração (sem dados reais)
# Copie este arquivo como .env e preencha com suas credenciais.
# =========================================================

# Azure AI Projects - Endpoint do seu projeto
# Encontre em: Azure Portal > Azure AI Projects > Overview > Endpoint
AZURE_AI_ENDPOINT=https://SEU-RECURSO.services.ai.azure.com/api/projects/SEU-PROJETO

# Nome do agente criado no Azure AI Studio
AZURE_AI_AGENT_NAME=nome-do-seu-agente

# Chave de API do Azure AI Projects
# Encontre em: Azure Portal > Azure AI Projects > Keys and Endpoint
AZURE_AI_API_KEY=SUA_CHAVE_AZURE_AQUI
